{
  "name": "equity-lab",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "data:update": "node scripts/update-data.mjs",
    "data:update:sample": "node --env-file-if-exists=.env.local scripts/update-data.mjs",
    "data:intelligence": "node scripts/update-intelligence.mjs",
    "data:government:leaderboard": "node scripts/build-government-leaderboard.mjs",
    "data:benchmarks": "node scripts/update-benchmarks.mjs",
    "data:signals": "node scripts/update-research-signals.mjs",
    "data:update:all": "npm run data:update && npm run data:benchmarks",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:data": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run bundle:check && npm run cloudflare:check && npm run test:data",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "cloudflare:check": "wrangler deploy --config dist/server/wrangler.json --dry-run",
    "deploy:cloudflare": "wrangler deploy --config dist/server/wrangler.json",
    "security:check": "npm audit --omit=dev --audit-level=high",
    "quality": "npm run lint && npm test && npm run security:check",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "lightweight-charts": "5.2.1",
    "next": "16.2.12",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici": "7.29.0"
  },
  "type": "module"
}
